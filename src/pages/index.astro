            <div class="edu-content">
              <div class="edu-top">
                <div class="story-num">2022 - 2025</div>
                <!-- Vß╗ï tr├¡ Logo tr╞░ß╗¥ng -->
                <div class="edu-logo">
                  <!-- Bß║ín h├úy thay URL logo thß║¡t cß╗ºa tr╞░ß╗¥ng Nh├ón Ch├¡nh v├áo ─æ├óy (╞░u ti├¬n file PNG kh├┤ng nß╗ün) -->
                  <img src="assets/images.jpg" alt="Nhan Chinh Logo">
                </div>
              </div>
              
              <div class="edu-text">
                <h3>NHAN CHINH HIGHSCHOOL</h3>
                <p>
                  GPA 9.12 <br> First time taking IELTS
                </p>
              </div>
            </div>
          </article>
    
          <!-- CARD 2: ─Éß║áI Hß╗îC PTIT -->
          <article class="story-card edu-card reveal">
            <!-- H├¼nh nß╗ün s├íng tß║ío -->
            <div class="edu-bg">
              <img src="assets/Thumbnail-ptit.jpg" alt="PTIT campus" />
            </div>
            
            <div class="edu-content">
              <div class="edu-top">
                <div class="story-num">2025 - Now</div>
                <!-- Vß╗ï tr├¡ Logo tr╞░ß╗¥ng -->
                <div class="edu-logo">
                  <!-- Bß║ín h├úy thay URL logo thß║¡t cß╗ºa PTIT v├áo ─æ├óy (╞░u ti├¬n file PNG kh├┤ng nß╗ün) -->
                  <img src="assets/Logo_PTIT_University.png" alt="PTIT Logo">
                </div>
              </div>
              
              <div class="edu-text">
                <h3>POSTS AND TELECOMMUNICATION INSTITUTE OF TECHNOLOGY</h3>
                <p>
                  Computer Science<br>CPA 3.61
                </p>
              </div>
            </div>
          </article>
        </div>
      </div>

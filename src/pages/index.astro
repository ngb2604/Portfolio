          <div class="lang reveal"><span class="lang-code">EN</span><h3>English</h3><p>IELTS 7.0</p><div class="bar"><span style="width:82%"></span></div></div>
          <div class="lang reveal"><span class="lang-code">JP</span><h3>Japanese</h3><p>Currently preparing for N5</p><div class="bar"><span style="width:38%"></span></div></div>
        </div>
      </div>
    </section>


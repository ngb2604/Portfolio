---
import "../styles/global.css";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Nguyen Gia Bao &mdash; technology student, builder and church volunteer." />
  <meta name="theme-color" content="#07090d" />
  <title>bvro.ngxn</title>
  <link rel="icon" type="image/png" href="/assets/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
</head>
<body>

  <canvas id="particles"></canvas>
  <div class="noise"></div>

  <nav>
    <a class="brand" href="#top">NG<span>B</span> &lt;3 DC<span>T</span></a>
    <ul>
      <li><a href="#about">ABOUT</a></li>
      <li><a href="#projects">PROJECTS</a></li>
      <li><a href="#education">EDUCATION</a></li>
      <li><a href="#languages">LANGUAGES</a></li>
      <li><a href="#contact">CONTACT</a></li>
    </ul>
   
  </nav>

  <main id="top">
    <section class="hero">
      <div class="container hero-grid">
        <div class="reveal">
          <div class="eyebrow">ABOUT ME // TECH STUDENT</div>
          <h1>GIA BAO<br><span class="ghost">NGUYEN</span></h1>
          <!-- <p class="hero-copy">
            I'm a Catholic, sophomore CS student who loves trying new things and grinding on the basketball court.
          </p> -->
          <div class="verse-box">
            <p>"No trial has come to you but what is human..."</p>
            <small>1 Cr 10,13</small>
          </div>
          <div class="hero-actions">
            <a class="btn primary" href="#projects">VIEW PROJECTS &#8599;</a>
            <a class="btn" href="#contact">LET'S CONNECT &#8594;</a>
          </div>
        </div>

        <div class="portrait-wrap reveal">
          <div class="portrait">
            <div class="portrait-track" aria-live="polite">
              <div class="portrait-slide active"><img src="assets/portrait.png" alt="Portrait of Nguyen Gia Bao"></div>
              <div class="portrait-slide"><img src="assets/1787930811700_2062869539153160763_7772012305005979200_eeb10d76672adc81b33c8caf4ef4ca98.jpg"></div>
              <div class="portrait-slide"><img src="assets/1787930811738_2062869539153160763_7772012305005979200_0e5f6f806b318f2c74bf960c672daf4f.jpg" alt="Casual portrait of Nguyen Gia Bao"></div>
              <div class="portrait-slide"><img src="assets/1787930811756_2062869539153160763_7772012305005979200_997ae15d75f9fb9a4c38a45112b16f81.jpg" alt="Portrait of Nguyen Gia Bao outdoors"></div>
            </div>
            <button class="portrait-control prev" type="button" aria-label="Previous portrait">&#8249;</button>
            <button class="portrait-control next" type="button" aria-label="Next portrait">&#8250;</button>
            <div class="portrait-status" aria-live="polite">01 / 04</div>
            <div class="portrait-dots" role="tablist" aria-label="Portrait gallery"></div>
          </div>
          <div class="floating-card fc1">DATA / CODE</div>
          <div class="floating-card fc2">PTIT // HANOI</div>
          <div class="floating-card fc3">CATHOLICS</div>
        </div>
      </div>
    </section>

    <section id="about">
      <div class="container">
        <div class="section-head reveal">
          <div>
            <div class="section-label">/PROFILE</div>
            <h2>About me.</h2>
          </div>
        </div>

        <div class="terminal reveal">
          <div class="terminal-top">
            <i class="terminal-dot"></i><i class="terminal-dot"></i><i class="terminal-dot"></i>
            <span class="terminal-title">nguyen-gia-bao.profile.json</span>
          </div>
          <div class="terminal-body">
            {'{'}<br>
            &nbsp;&nbsp;<span class="key">"name"</span>: <span class="str">"Nguyen Gia Bao"</span>,<br>
            &nbsp;&nbsp;<span class="key">"focus"</span>: <span class="str">"God / Family / Future"</span>,<br>
            &nbsp;&nbsp;<span class="key">"education"</span>: <span class="str">"PTIT &mdash; Computer Science"</span>,<br>
            &nbsp;&nbsp;<span class="key">"interests"</span>: [<span class="str">"Basketball"</span>, <span class="str">"Vibe coding"</span>, <span class="str">"Hanging"</span>],<br>
            {'}'}
          </div>
        </div>
      </div>
    </section>

    <section id="gallery">
      <div class="container">
        <div class="section-head reveal">
          <div>
            <div class="section-label">/LIFE LOG</div>
            <h2>Daily life</h2>
          </div>
      
        </div>

        <div class="gallery">
          <figure class="gallery-item full-image reveal">
            <img src="assets/mot.jpg" alt="Circuit board">
            <figcaption class="gallery-caption">LOVING</figcaption>
          </figure>
          <figure class="gallery-item reveal">
            <img src="assets/hai.jpg" alt="Code on screen">
            <figcaption class="gallery-caption">STILL LOVING</figcaption>
          </figure>
          <figure class="gallery-item reveal">
            <img src="assets/ba.jpg" alt="Data dashboard">
            <figcaption class="gallery-caption">SERVING</figcaption>
          </figure>
          <figure class="gallery-item reveal">
            <img src="assets/bon.jpg" alt="Friends outdoors">
            <figcaption class="gallery-caption">STUDYING</figcaption>
          </figure>
          <figure class="gallery-item image-bottom reveal">
            <img src="assets/nam.jpg" alt="Team together">
            <figcaption class="gallery-caption">EXPLORING</figcaption>
          </figure>
          <figure class="gallery-item reveal">
            <img src="assets/sau.jpg" alt="Laptop and workspace">
            <figcaption class="gallery-caption">SOCIALIZING</figcaption>
          </figure>
          <figure class="gallery-item image-bottom reveal">
            <img src="assets/bay.jpg" alt="People collaborating in an office">
            <figcaption class="gallery-caption">EXPERIENCING</figcaption>
          </figure>
          <figure class="gallery-item reveal">
            <img src="assets/tam.jpg" alt="Team meeting around a table">
            <figcaption class="gallery-caption">EARNING</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="projects">
      <div class="container">
        <div class="section-head reveal">
          <div>
            <div class="section-label">/PROJECT LOG</div>
            <h2>Built over time.</h2>
          </div>
        </div>

        <div class="timeline">
          <article class="project reveal">
            <div class="project-date">2026 &mdash; NOW</div>
            <div class="project-card">
              <div class="project-image">
                <img src="https://images.unsplash.com/photo-1555949963-aa79dcee981c?auto=format&fit=crop&w=900&q=85" alt="Developer workspace">
              </div>
              <div class="project-info">
                <div class="project-tag">DATA SYSTEM / 001</div>
                <h3>Project Alpha</h3>
                <p>Replace this with your strongest current data/system project. Explain the real-world problem, what you built, and what you learned.</p>
                <div class="techs"><span class="tech">Python</span><span class="tech">SQL</span><span class="tech">Git</span></div>
              </div>
            </div>
          </article>

          <article class="project reveal">
            <div class="project-date">2026</div>
            <div class="project-card">
              <div class="project-image">
                <img src="https://images.unsplash.com/photo-1558655146-d09347e92766?auto=format&fit=crop&w=900&q=85" alt="Web interface design">
              </div>
              <div class="project-info">
                <div class="project-tag">WEB / 002</div>
                <h3>Church Student System</h3>
                <p>A practical management platform concept for students, teachers, parents, schedules, events, and community communication.</p>
                <div class="techs"><span class="tech">HTML</span><span class="tech">CSS</span><span class="tech">JavaScript</span><span class="tech">Database</span></div>
              </div>
            </div>
          </article>

          <article class="project reveal">
            <div class="project-date">2025</div>
            <div class="project-card">
              <div class="project-image">
                <img src="https://images.unsplash.com/photo-1515879218367-8466d910aaa4?auto=format&fit=crop&w=900&q=85" alt="Programming code">
              </div>
              <div class="project-info">
                <div class="project-tag">FOUNDATION / 003</div>
                <h3>Programming Foundations</h3>
                <p>Your earlier C/C++ work belongs here &mdash; algorithms, data structures, small utilities, experiments, and the first steps into software engineering.</p>
                <div class="techs"><span class="tech">C</span><span class="tech">C++</span><span class="tech">Algorithms</span></div>
              </div>
            </div>
          </article>

        </div>
      </div>
    </section>

    <section id="education">
      <div class="container">
        <div class="section-head reveal">
          <div>
            <div class="section-label">/EDUCATION</div>
            <h2>Academic journey.</h2>
